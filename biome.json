{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!site"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": { "noNonNullAssertion": "off" },
      "complexity": { "noCommaOperator": "off" },
      "suspicious": { "noAssignInExpressions": "off", "noTemplateCurlyInString": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [{ "includes": ["test/**"], "linter": { "rules": { "correctness": { "useYield": "off" } } } }]
}
